# Copia este archivo como .env y llena los valores
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/finto?retryWrites=true&w=majority
JWT_SECRET=una_cadena_larga_y_aleatoria
PORT=4000

# Correo para enviar códigos de recuperación (opcional en desarrollo: sin esto el código sale en la consola)
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tucorreo@gmail.com,
# SMTP_PASS=contraseña de aplicación de 16 letras (no tu contraseña normal)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Finto <tucorreo@gmail.com>
